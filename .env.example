# ============================================================
# .env.example - a TEMPLATE, safe to share and commit to git.
#
# It lists WHICH settings the app needs, with fake values.
# Copy it to a file called .env and fill in your real values there.
# .env is listed in .gitignore, so your real secrets never leave
# your computer. This pair of files is a standard habit worth keeping.
# ============================================================

# The address of your Supabase Postgres database.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Remember to replace [YOUR-PASSWORD] with your actual database password.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# A made-up password that staff must send to use the staff routes.
# This is a MOCK stand-in for a real login system. Invent anything.
STAFF_KEY=change-me-staff-key

# A made-up shared password between our fake payment provider and our
# webhook route, so we can tell real events from forged ones (step 7).
WEBHOOK_SECRET=change-me-webhook-secret

# Which port the website runs on locally.
PORT=3000
